# Combined .gitignore for PWA + Salesforce

# PWA
pwa-sync-starter/web/node_modules/
pwa-sync-starter/web/dist/
pwa-sync-starter/web/build/
pwa-sync-starter/web/.env.local
pwa-sync-starter/server/data/
pwa-sync-starter/server/.env
pwa-sync-starter/server/__pycache__/

# Database files
*.db
*.duckdb
*.sqlite
*.sqlite3

# Node modules everywhere
node_modules/
**/node_modules/

# Build artifacts
dist/
build/
dev-dist/

# Salesforce - Exclude ALL standard library and generated files
pwa-sync-starter/.sfdx/
tgthrProgramManagement/.sf/
tgthrProgramManagement/.sfdx/
.sfdx/
.sf/

# Salesforce standard library (the garbage)
**/StandardApexLibrary/
**/.sfdx/tools/

# Shared
*.log
.DS_Store
.vscode/settings.json
# Local client exports and diagnostic artifacts (privacy cleanup 2026-10-06)
/.tmp-*
/.tmp_*
/recovery/case-*/
/pwa-sync-starter/case_trace_*.json
/pwa-sync-starter/newDataSchemaFiles/Person Account Building/
/pwa-sync-starter/server.db*
/pwa-sync-starter/server/server.db*
/tgthrProgramManagement/*-records.csv
/tgthrProgramManagement/stale_goals*.csv
/tgthrProgramManagement/maggie_records.*
/tgthrProgramManagement/all_related.xml
/tgthrProgramManagement/null_notes.xml
/tgthrProgramManagement/.tmp*/
/tgthrProgramManagement/.tmp*
/tgthrProgramManagement/test-results/
/tgthrProgramManagement/temp_retrieve/
/tgthrProgramManagement/temp_permsets/
/tgthrProgramManagement/temp_tgthr_benefits/
/tgthrProgramManagement/retrieved-metadata/
/tgthrProgramManagement/scripts/data/*enrollment*.csv
/tgthrProgramManagement/scripts/data/*assignment*.csv
/tgthrProgramManagement/scripts/data/*disbursement*.csv
/tgthrProgramManagement/scripts/data/case_*.csv
/tgthrProgramManagement/scripts/data/*housing_cases*.csv
/tgthrProgramManagement/scripts/interview-migration/*-records.csv
